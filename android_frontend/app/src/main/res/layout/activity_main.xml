<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Scoreboard at the top -->
    <TextView
        android:id="@+id/scoreboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score   King (X): 0   Queen (O): 0   |   Games: 0"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/primary"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <!-- Game Status/Feedback -->
    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="King's (X) turn"
        android:textSize="16sp"
        android:textStyle="italic"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/scoreboard"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- 3x3 Board -->
    <GridLayout
        android:id="@+id/gameGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rowCount="3"
        android:columnCount="3"
        android:background="@color/secondary"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/status"
        app:layout_constraintBottom_toTopOf="@+id/resetBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintWidth_percent="0.75"
        app:layout_constraintHeight_percent="0.4">

        <!-- 9 cells: Each is an ImageView, tagged 0-8 -->
        <ImageView
            android:id="@+id/cell0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0" android:layout_column="0"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="0"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0" android:layout_column="1"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="1"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0" android:layout_column="2"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="2"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1" android:layout_column="0"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="3"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1" android:layout_column="1"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="4"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1" android:layout_column="2"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="5"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2" android:layout_column="0"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="6"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2" android:layout_column="1"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="7"
            android:clickable="true"
            android:onClick="onCellClicked"/>
        <ImageView
            android:id="@+id/cell8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2" android:layout_column="2"
            android:layout_columnWeight="1" android:layout_rowWeight="1"
            android:background="@drawable/cell_background"
            android:contentDescription="@string/cell"
            android:tag="8"
            android:clickable="true"
            android:onClick="onCellClicked"/>
    </GridLayout>

    <!-- RESET button, below grid -->
    <Button
        android:id="@+id/resetBtn"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="Reset Game"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/gameGrid"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
